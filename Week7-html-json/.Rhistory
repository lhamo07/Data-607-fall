library(readr)
library(dplyr)
library(countrycode)
# load data
raw_df<-read.csv("https://raw.githubusercontent.com/lhamo07/Data-606-project/refs/heads/main/9e5de16b-e1cd-471d-a412-8f96210951be_Series%20-%20Metadata.csv?token=GHSAT0AAAAAAEHGEMVIXYVDXYTWVZ3INQZG2XCVRZQ")
# load data
raw_df<-read.csv("https://raw.githubusercontent.com/lhamo07/Data-606-project/refs/heads/main/9e5de16b-e1cd-471d-a412-8f96210951be_Series%20-%20Metadata.csv?token=GHSAT0AAAAAAEHGEMVIXYVDXYTWVZ3INQZG2XCVRZQ")
# load data
raw_df<-read.csv("https://raw.githubusercontent.com/lhamo07/Data-606-project/refs/heads/main/9e5de16b-e1cd-471d-a412-8f96210951be_Series%20-%20Metadata.csv?token=GHSAT0AAAAAAEHGEMVIXYVDXYTWVZ3INQZG2XCVRZQ")
# load data
raw_df<-read.csv("https://raw.githubusercontent.com/lhamo07/Data-606-project/refs/heads/main/9e5de16b-e1cd-471d-a412-8f96210951be_Series%20-%20Metadata.csv?token=GHSAT0AAAAAAEHGEMVIPXTKLDHDRPBLTCJ42XEC6UA")
# Drop unnecessary variables
df<-raw_df%>%select(-Series.Name,-Series.Code)%>%
#Rename columns to more descriptive form.
rename(country_name=Country.Name,
country_code=Country.Code,
life_exp_2015=X2015..YR2015.,
life_exp_2016=X2016..YR2016.,
life_exp_2017=X2017..YR2017.,
life_exp_2018=X2018..YR2018.,
life_exp_2019=X2019..YR2019.,
life_exp_2020=X2020..YR2020.,
life_exp_2021=X2021..YR2021.,
life_exp_2022=X2022..YR2022.,
life_exp_2023=X2023..YR2023.,
life_exp_2024=X2024..YR2024.,
)
# check any missing value
any(is.na(df))
#filter only countries
country_table<-df%>%
filter(!is.na(countrycode(country_code, "wb", "country.name",
warn = FALSE)))%>%
distinct(country_name,.keep_all=TRUE)
# Convert life expectancy columns to numeric
country_table <- country_table %>%
mutate(
across(starts_with("life_exp_"), as.numeric)
)
country_table
glimpse(country_table)
