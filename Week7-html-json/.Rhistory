#Rename columns to more descriptive form.
rename(country_name=Country.Name,
country_code=Country.Code,
life_exp_2015=X2015..YR2015.,
life_exp_2016=X2016..YR2016.,
life_exp_2017=X2017..YR2017.,
life_exp_2018=X2018..YR2018.,
life_exp_2019=X2019..YR2019.,
life_exp_2020=X2020..YR2020.,
life_exp_2021=X2021..YR2021.,
life_exp_2022=X2022..YR2022.,
life_exp_2023=X2023..YR2023.,
life_exp_2024=X2024..YR2024.,
)
# check any missing value
any(is.na(df))
#filter only countries
country_table<-df%>%
filter(!is.na(countrycode(country_code, "wb", "country.name",
warn = FALSE)))%>%
distinct(country_name,.keep_all=TRUE)
